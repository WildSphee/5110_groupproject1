model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-HK
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table Country
ref table Team
ref table Rider
ref table Stage
ref table 'As Of'
ref table Result
ref table Standing
ref table 'Team Stage'
ref table 'Team Standing'
ref table Classification
ref table Metrics
ref table Scenario

ref cultureInfo en-US

