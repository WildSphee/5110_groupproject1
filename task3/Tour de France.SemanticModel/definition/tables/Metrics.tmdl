/// Fictional BT5110 demo. See task3/docs/semantics.md for grain and rules.
table Metrics
	lineageTag: 163acef5-4c86-40ee-b599-ac64a7388227

	/// Latest selected stage; no selection means stage 21.
	measure 'As of Stage Number' = MAX('As Of'[Stage])
		formatString: 0
		displayFolder: Context
		lineageTag: 4235e109-414e-4489-94d1-c2b7debe3ce6

	/// Snapshot Label
	measure 'Snapshot Label' = "STANDINGS AFTER STAGE " & FORMAT([As of Stage Number], "00")
		displayFolder: Context
		lineageTag: cb272e0a-8f82-46c7-918b-08b57aa4af26

	/// Registered Riders
	measure 'Registered Riders' = COUNTROWS('Rider')
		formatString: 0
		displayFolder: Participation
		lineageTag: 7b1ac6fb-7a21-458b-b659-3dbd73af341e

	/// Registered Teams
	measure 'Registered Teams' = COUNTROWS('Team')
		formatString: 0
		displayFolder: Participation
		lineageTag: eb8b8ee6-db0d-4adb-b1ab-6af224c5e779

	/// Stage Finishes
	measure 'Stage Finishes' = COUNTROWS('Result')
		formatString: #,0
		displayFolder: Performance
		lineageTag: 5bd554bb-614d-481a-a548-1a2cde5fcdac

	/// Adjusted Hours
	measure 'Adjusted Hours' = DIVIDE(SUM('Result'[Adjusted Seconds]),3600)
		formatString: #,0.00
		displayFolder: Performance
		lineageTag: e4cdeca2-5129-4ce3-987a-3ce25c8e4d1b

	/// Adjusted Seconds
	measure 'Adjusted Seconds' = SUM('Result'[Adjusted Seconds])
		formatString: #,0
		displayFolder: Performance
		lineageTag: 083c40d0-f898-4e9f-b687-7113fecfaacd

	/// Finish Seconds
	measure 'Finish Seconds' = SUM('Result'[Finish Seconds])
		formatString: #,0
		displayFolder: Performance
		lineageTag: 949846fb-3e90-4f03-a7c5-116d7aa38b3d

	/// Bonus Seconds
	measure 'Bonus Seconds' = SUM('Result'[Bonus Seconds])
		formatString: #,0
		displayFolder: Performance
		lineageTag: b82d9e6a-daa3-4ccf-87af-fcf6b55bed56

	/// Penalty Seconds
	measure 'Penalty Seconds' = SUM('Result'[Penalty Seconds])
		formatString: #,0
		displayFolder: Performance
		lineageTag: 9631c045-b781-46f1-9b14-92db96150a96

	/// Stage Position
	measure 'Stage Position' = IF(HASONEVALUE('Rider'[Bib]) && HASONEVALUE('Stage'[Stage]), MAX('Result'[Position]))
		formatString: 0
		displayFolder: Performance
		lineageTag: 00efb5d4-c6de-4bcb-a651-2e9269df139c

	/// Stage Points
	measure 'Stage Points' = SUM('Result'[Points])
		formatString: #,0
		displayFolder: Performance
		lineageTag: 88d191c3-1136-4b0f-adf6-8b13d3fe41de

	/// Stage KOM Points
	measure 'Stage KOM Points' = SUM('Result'[KOM Points])
		formatString: #,0
		displayFolder: Performance
		lineageTag: cbf94d7b-d3a5-439a-99c2-88058559bebb

	/// Average Stage Minutes
	measure 'Average Stage Minutes' = DIVIDE(AVERAGE('Result'[Adjusted Seconds]),60)
		formatString: 0.0
		displayFolder: Performance
		lineageTag: dce2f44c-b53c-4850-9129-f8668d857e57

	/// Eligible Riders
	measure 'Eligible Riders' = VAR s = [As of Stage Number] RETURN CALCULATE(SUM('Standing'[Eligible]), REMOVEFILTERS('Stage'), 'Standing'[Stage] = s)
		formatString: 0
		displayFolder: Performance
		lineageTag: ac237848-0920-49f9-8fce-690f8f7ab78a

	/// Explicit withdrawals by the selected stage; incomplete results alone are not an exit.
	measure 'Exited Riders' = VAR s=[As of Stage Number] RETURN COALESCE(COUNTROWS(FILTER('Rider',NOT ISBLANK('Rider'[Exit Stage]) && 'Rider'[Exit Stage]<=s)),0)
		formatString: 0
		displayFolder: Performance
		lineageTag: f50f6f0d-1b3a-48a9-a7ee-239a156283e7

	/// Sum of eligible riders cumulative adjusted time in the selected rider/team slice.
	measure 'Eligible Cumulative Hours' = VAR s = [As of Stage Number] RETURN CALCULATE(DIVIDE(CALCULATE(SUM('Standing'[Cumulative Seconds]), 'Standing'[Eligible] = 1),3600), REMOVEFILTERS('Stage'), 'Standing'[Stage] = s)
		formatString: #,0.00
		displayFolder: Performance
		lineageTag: 63dbc432-f3cd-4dfd-9c1e-156334137803

	/// Rider Cumulative Seconds
	measure 'Rider Cumulative Seconds' = IF(HASONEVALUE('Rider'[Bib]), VAR s = [As of Stage Number] RETURN CALCULATE(CALCULATE(MAX('Standing'[Cumulative Seconds]), 'Standing'[Eligible]=1), REMOVEFILTERS('Stage'), 'Standing'[Stage] = s))
		formatString: #,0
		displayFolder: Performance
		lineageTag: 1f31663d-8089-4695-a6a1-5b7a911255ce

	/// Rider Cumulative Time
	measure 'Rider Cumulative Time' = VAR t=[Rider Cumulative Seconds] RETURN IF(NOT ISBLANK(t), FORMAT(INT(t/3600),"0") & ":" & FORMAT(INT(MOD(t,3600)/60),"00") & ":" & FORMAT(MOD(t,60),"00"))
		displayFolder: Performance
		lineageTag: 19b8f521-9d7d-4db2-a0d6-3adf8dc5a621

	/// Global competition rank. Preserved under rider/team filtering; blank when ineligible.
	measure 'GC Rank' = IF(HASONEVALUE('Rider'[Bib]), VAR s = [As of Stage Number] RETURN CALCULATE(MAX('Standing'[GC Rank]), REMOVEFILTERS('Stage'), 'Standing'[Stage] = s))
		formatString: 0
		displayFolder: Classifications
		lineageTag: 5ee647e5-1911-4a30-b7f6-22e2cc79016c

	/// Global competition rank. Preserved under rider/team filtering; blank when ineligible.
	measure 'Points Rank' = IF(HASONEVALUE('Rider'[Bib]), VAR s = [As of Stage Number] RETURN CALCULATE(MAX('Standing'[Points Rank]), REMOVEFILTERS('Stage'), 'Standing'[Stage] = s))
		formatString: 0
		displayFolder: Classifications
		lineageTag: b7241019-f9ae-44c1-a003-37cd31d47896

	/// Global competition rank. Preserved under rider/team filtering; blank when ineligible.
	measure 'KOM Rank' = IF(HASONEVALUE('Rider'[Bib]), VAR s = [As of Stage Number] RETURN CALCULATE(MAX('Standing'[KOM Rank]), REMOVEFILTERS('Stage'), 'Standing'[Stage] = s))
		formatString: 0
		displayFolder: Classifications
		lineageTag: 304ab33d-0c00-4a8a-bf41-9476c14300ba

	/// Global competition rank. Preserved under rider/team filtering; blank when ineligible.
	measure 'Young Rank' = IF(HASONEVALUE('Rider'[Bib]), VAR s = [As of Stage Number] RETURN CALCULATE(MAX('Standing'[Young Rank]), REMOVEFILTERS('Stage'), 'Standing'[Stage] = s))
		formatString: 0
		displayFolder: Classifications
		lineageTag: 9f0df7ac-15d9-4e11-9e6c-d57fff878aeb

	/// Cumulative Points
	measure 'Cumulative Points' = VAR s = [As of Stage Number] RETURN CALCULATE(CALCULATE(SUM('Standing'[Points]), 'Standing'[Eligible]=1), REMOVEFILTERS('Stage'), 'Standing'[Stage] = s)
		formatString: #,0
		displayFolder: Classifications
		lineageTag: 2226097f-fe18-4d8b-90e9-f9f0ef2f5b8b

	/// Cumulative KOM Points
	measure 'Cumulative KOM Points' = VAR s = [As of Stage Number] RETURN CALCULATE(CALCULATE(SUM('Standing'[KOM Points]), 'Standing'[Eligible]=1), REMOVEFILTERS('Stage'), 'Standing'[Stage] = s)
		formatString: #,0
		displayFolder: Classifications
		lineageTag: 641cf3e1-d6cb-4860-a124-5aa76c9ee20f

	/// Rider Status
	measure 'Rider Status' = IF(HASONEVALUE('Rider'[Bib]), VAR s = [As of Stage Number] RETURN CALCULATE(SELECTEDVALUE('Standing'[Status]), REMOVEFILTERS('Stage'), 'Standing'[Stage] = s))
		displayFolder: Context
		lineageTag: a1d8ea8e-9e26-4fc6-ad76-6d1bf9d07567

	/// Gap to global GC leader, seconds.
	measure 'GC Gap Seconds' = VAR t=[Rider Cumulative Seconds] VAR s=[As of Stage Number] VAR leader=CALCULATE(MIN('Standing'[Cumulative Seconds]),REMOVEFILTERS('Rider'),REMOVEFILTERS('Stage'),'Standing'[Stage]=s,'Standing'[Eligible]=1) RETURN IF(NOT ISBLANK(t),t-leader)
		formatString: #,0
		displayFolder: Classifications
		lineageTag: 2eb5b860-c2b5-46fd-92e6-b20a58690f03

	/// Classification Rank
	measure 'Classification Rank' = SWITCH(SELECTEDVALUE('Classification'[Classification]),"General",[GC Rank],"Points",[Points Rank],"Mountains",[KOM Rank],"Young Rider",[Young Rank])
		formatString: 0
		displayFolder: Classifications
		lineageTag: 98f76fb7-0bba-4b97-bd64-934efdfc7553

	/// The same eligible field participates in General, Points and Mountains; time is not their points score.
	measure 'Classification Rider Hours' = VAR c=SELECTEDVALUE('Classification'[Classification]) RETURN IF(c="Young Rider",CALCULATE([Eligible Cumulative Hours],'Rider'[Young Rider]=1),[Eligible Cumulative Hours])
		formatString: #,0.00
		displayFolder: Classifications
		lineageTag: 05fe3938-da01-4a5d-92dd-ca1c08d1837a

	/// All stage types through the x-axis stage; includes historical completed effort before exits.
	measure 'Running Rider Hours' = VAR s=MAX('Stage'[Stage]) RETURN CALCULATE(DIVIDE(SUM('Result'[Adjusted Seconds]),3600),FILTER(ALL('Stage'),'Stage'[Stage]<=s))
		formatString: #,0.00
		displayFolder: Performance
		lineageTag: daa12025-05c0-45aa-9bd6-a2aa8ecdfa57

	/// Rank by stages scored DESC, then cumulative stage top-3 time ASC.
	measure 'Best Team Rank' = IF(HASONEVALUE('Team'[Team]), VAR s = [As of Stage Number] RETURN CALCULATE(MAX('Team Standing'[Team Rank]), REMOVEFILTERS('Stage'), 'Team Standing'[Stage] = s))
		formatString: 0
		displayFolder: Team
		lineageTag: c9e032ac-c249-4534-be58-b8f19ea04fd3

	/// Team Cumulative Hours
	measure 'Team Cumulative Hours' = VAR s = [As of Stage Number] RETURN CALCULATE(DIVIDE(SUM('Team Standing'[Cumulative Top3 Seconds]),3600), REMOVEFILTERS('Stage'), 'Team Standing'[Stage] = s)
		formatString: #,0.00
		displayFolder: Team
		lineageTag: 14e8cb07-45ac-4309-afbc-1bf28033409b

	/// Stages Scored
	measure 'Stages Scored' = IF(HASONEVALUE('Team'[Team]), VAR s = [As of Stage Number] RETURN CALCULATE(MAX('Team Standing'[Stages Scored]), REMOVEFILTERS('Stage'), 'Team Standing'[Stage] = s))
		formatString: 0
		displayFolder: Team
		lineageTag: 36567775-f757-4446-a90b-2abd1ec8c711

	/// Team Coverage
	measure 'Team Coverage' = IF(HASONEVALUE('Team'[Team]), VAR s = [As of Stage Number] RETURN CALCULATE(SELECTEDVALUE('Team Standing'[Coverage]), REMOVEFILTERS('Stage'), 'Team Standing'[Stage] = s))
		displayFolder: Team
		lineageTag: ad5e0617-8bcf-45f0-ab52-294c0235c68a

	/// Stage Top3 Hours
	measure 'Stage Top3 Hours' = DIVIDE(SUM('Team Stage'[Top3 Seconds]),3600)
		formatString: #,0.00
		displayFolder: Team
		lineageTag: fd6f31e8-3798-465f-95e2-f637b9c6f4c4

	/// Team Finishers
	measure 'Team Finishers' = IF(HASONEVALUE('Stage'[Stage]) && HASONEVALUE('Team'[Team]),MAX('Team Stage'[Finishers]))
		formatString: 0
		displayFolder: Team
		lineageTag: b58ee5b9-c689-46fd-bf86-aaa31a4edc54

	/// Country dimension intentionally applies team nationality independently.
	measure 'Teams by Country' = COALESCE(CALCULATE(COUNTROWS('Team'),KEEPFILTERS(TREATAS(VALUES('Country'[Country]),'Team'[Team Country]))),0)
		formatString: 0
		displayFolder: Participation
		lineageTag: ea2cd101-b2d7-410f-93a0-ea15c32fd0df

	/// Registered rider nationality, independent of team nationality; includes exited riders.
	measure 'Riders by Country' = COALESCE(CALCULATE(COUNTROWS('Rider'),KEEPFILTERS(TREATAS(VALUES('Country'[Country]),'Rider'[Rider Country]))),0)
		formatString: 0
		displayFolder: Participation
		lineageTag: fba36dc5-5772-45f7-9fdd-5a7910d29779

	/// Foreign Team Riders
	measure 'Foreign Team Riders' = COUNTROWS(FILTER('Rider','Rider'[Rider Country]<>'Rider'[Team Country]))
		formatString: 0
		displayFolder: Participation
		lineageTag: cd446f34-228f-47db-ad12-1e08fc26b15a

	/// Foreign Team Share
	measure 'Foreign Team Share' = DIVIDE([Foreign Team Riders],[Registered Riders])
		formatString: 0.0%
		displayFolder: Participation
		lineageTag: 4cd32a34-b7f6-44e9-a3c5-08516f38c19b

	/// Country Foreign Riders
	measure 'Country Foreign Riders' = COALESCE(CALCULATE([Foreign Team Riders],KEEPFILTERS(TREATAS(VALUES('Country'[Country]),'Rider'[Rider Country]))),0)
		formatString: 0
		displayFolder: Participation
		lineageTag: f478bbfe-2d41-4098-a82e-befe68a22bd0

	/// Countries Represented
	measure 'Countries Represented' = COUNTROWS(FILTER(ALL('Country'),[Teams by Country]+[Riders by Country]>0))
		formatString: 0
		displayFolder: Participation
		lineageTag: bd812b4b-c6b2-48ac-b8d8-8f959c535b58

	/// Intersection of selected country and roster hierarchy; blank hides unrelated roster branches.
	measure 'Roster Riders' = CALCULATE(COUNTROWS('Rider'),KEEPFILTERS(TREATAS(VALUES('Country'[Country]),'Rider'[Rider Country])))
		formatString: 0
		displayFolder: Participation
		lineageTag: fbe8def8-0749-4ab6-96c0-f34cbb1d316c

	/// Top Ten Finishes
	measure 'Top Ten Finishes' = COALESCE(CALCULATE(COUNTROWS('Result'),KEEPFILTERS('Result'[Position]<=10)),0)
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: 8498f09a-8a10-49a2-96cf-e46f09503445

	/// Stage Wins
	measure 'Stage Wins' = COALESCE(CALCULATE(COUNTROWS('Result'),KEEPFILTERS('Result'[Position]=1)),0)
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: e41c25e5-23e3-43bd-8a3d-cdc0d1002ea0

	/// Stage Podiums
	measure 'Stage Podiums' = COALESCE(CALCULATE(COUNTROWS('Result'),KEEPFILTERS('Result'[Position]<=3)),0)
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: 3525d19e-9d3f-47b9-a2f2-fd8d55202d99

	/// Mountain Podiums
	measure 'Mountain Podiums' = CALCULATE([Stage Podiums],KEEPFILTERS('Stage'[Stage Type]="Mountain"))
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: 3a899a85-d14c-49dc-8922-50e6a8482f3d

	/// Mean adjusted-time gap to the rider placed first; can be negative after adjustments.
	measure 'Stage Winner Gap Seconds' = AVERAGEX('Result', VAR s='Result'[Stage] VAR winner=CALCULATE(MIN('Result'[Adjusted Seconds]),REMOVEFILTERS('Rider'),REMOVEFILTERS('Result'),'Result'[Stage]=s,'Result'[Position]=1) RETURN 'Result'[Adjusted Seconds]-winner)
		formatString: 0.0
		displayFolder: PDF analytics
		lineageTag: a62dfeaa-5db1-4ae7-8396-6ef95bd0fa36

	/// Mountain Mean Gap Seconds
	measure 'Mountain Mean Gap Seconds' = CALCULATE([Stage Winner Gap Seconds],KEEPFILTERS('Stage'[Stage Type]="Mountain"))
		formatString: 0.0
		displayFolder: PDF analytics
		lineageTag: 5433e59f-0c36-4dcf-b808-4089cc50ae04

	/// Distance / raw finish hours. Teams use summed rider-distance / summed rider-time, not summed speeds.
	measure 'Speed Proxy kmh' = DIVIDE(SUMX('Result',RELATED('Stage'[Distance km])),DIVIDE(SUM('Result'[Finish Seconds]),3600))
		formatString: 0.0
		displayFolder: PDF analytics
		lineageTag: d1f72993-07d5-41d6-82fa-bc9930e22683

	/// Mountain Cumulative Seconds
	measure 'Mountain Cumulative Seconds' = IF(HASONEVALUE('Rider'[Bib]) && NOT ISBLANK([GC Rank]), VAR s=[As of Stage Number] RETURN CALCULATE(SUM('Result'[Adjusted Seconds]),FILTER(ALL('Stage'),'Stage'[Stage]<=s && 'Stage'[Stage Type]="Mountain")))
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: 60d9d21b-3016-4c9c-81ad-25bc6ad53d6f

	/// Time-only mountain proxy, distinct from KOM points.
	measure 'Mountain GC Proxy Rank' = VAR t=[Mountain Cumulative Seconds] VAR field=FILTER(ALL('Rider'),NOT ISBLANK(CALCULATE([Mountain Cumulative Seconds]))) RETURN IF(NOT ISBLANK(t),RANKX(field,[Mountain Cumulative Seconds],t,ASC,Skip))
		formatString: 0
		displayFolder: PDF analytics
		lineageTag: 097a860a-ae31-49b4-996e-b482881611aa

	/// Under 26 on the first stage date; separate from the original calendar-year Young Rider rule.
	measure 'Young GC at Race Start Rank' = VAR t=[Rider Cumulative Seconds] VAR age=SELECTEDVALUE('Rider'[Age at Race Start]) VAR field=FILTER(ALL('Rider'),'Rider'[Age at Race Start]<26 && NOT ISBLANK(CALCULATE([Rider Cumulative Seconds]))) RETURN IF(NOT ISBLANK(t) && age<26,RANKX(field,[Rider Cumulative Seconds],t,ASC,Skip))
		formatString: 0
		displayFolder: PDF analytics
		lineageTag: 38f94d36-947b-44e0-a5db-b216ec8d97f2

	/// GC Trace Hours
	measure 'GC Trace Hours' = IF(HASONEVALUE('Rider'[Bib]),DIVIDE(CALCULATE(MAX('Standing'[Cumulative Seconds]),'Standing'[Eligible]=1),3600))
		formatString: 0.00
		displayFolder: PDF analytics
		lineageTag: d3eb8ced-02e4-410c-93ba-0785b2ce9687

	/// GC Trace Rank
	measure 'GC Trace Rank' = IF(HASONEVALUE('Rider'[Bib]) && HASONEVALUE('Stage'[Stage]),MAX('Standing'[GC Rank]))
		formatString: 0
		displayFolder: PDF analytics
		lineageTag: 0cd0cae6-26a3-4846-8d6b-e5a780c30485

	/// Positive = places gained; blank on first stage or after exit.
	measure 'GC Rank Change' = VAR s=SELECTEDVALUE('Stage'[Stage]) VAR nowRank=[GC Trace Rank] VAR prior=CALCULATE(MAX('Standing'[GC Rank]),REMOVEFILTERS('Stage'),'Standing'[Stage]=s-1) RETURN IF(NOT ISBLANK(nowRank) && NOT ISBLANK(prior),prior-nowRank)
		formatString: 0
		displayFolder: PDF analytics
		lineageTag: a86a2c97-8560-4ec4-a06b-b5e400863d14

	/// Mountain Trace Hours
	measure 'Mountain Trace Hours' = CALCULATE([GC Trace Hours],KEEPFILTERS('Stage'[Stage Type]="Mountain"))
		formatString: 0.00
		displayFolder: PDF analytics
		lineageTag: cca1e03b-6dae-4568-bedb-21e2ad064ed7

	/// Stage Distance km
	measure 'Stage Distance km' = SELECTEDVALUE('Stage'[Distance km])
		formatString: 0.0
		displayFolder: PDF analytics
		lineageTag: ce347a56-8792-4e33-8911-a7a06d7320dd

	/// Stage Winner
	measure 'Stage Winner' = VAR winner=CALCULATE(SELECTEDVALUE('Result'[Bib]),REMOVEFILTERS('Rider'),'Result'[Position]=1) RETURN IF(NOT ISBLANK(winner),LOOKUPVALUE('Rider'[Rider Label],'Rider'[Bib],winner))
		displayFolder: PDF analytics
		lineageTag: 85c5dd1d-b112-46f3-81d2-f764a149ac5f

	/// Top Ten Adjusted Seconds
	measure 'Top Ten Adjusted Seconds' = IF(HASONEVALUE('Rider'[Bib]) && HASONEVALUE('Stage'[Stage]),CALCULATE(SUM('Result'[Adjusted Seconds]),KEEPFILTERS('Result'[Position]<=10)))
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: 10ea5534-f482-410b-9e74-477785aa6a40

	/// Top Ten Position
	measure 'Top Ten Position' = VAR pos=[Stage Position] RETURN IF(NOT ISBLANK(pos) && pos<=10,pos)
		formatString: 0
		displayFolder: PDF analytics
		lineageTag: 2c6a6db7-18af-49e9-8d1a-2fa91af62006

	/// Cumulative Bonus Seconds
	measure 'Cumulative Bonus Seconds' = VAR s=[As of Stage Number] RETURN CALCULATE([Bonus Seconds],FILTER(ALL('Stage'),'Stage'[Stage]<=s))
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: ada64c83-cd4f-49bd-b60d-e7bc191afc00

	/// Cumulative Penalty Seconds
	measure 'Cumulative Penalty Seconds' = VAR s=[As of Stage Number] RETURN CALCULATE([Penalty Seconds],FILTER(ALL('Stage'),'Stage'[Stage]<=s))
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: 398b333e-fb44-4fc3-9a46-46016c3d0447

	/// Scenario Seconds
	measure 'Scenario Seconds' = VAR t=[Rider Cumulative Seconds] VAR mode=SELECTEDVALUE('Scenario'[Scenario],"Official adjusted") RETURN IF(NOT ISBLANK(t),t+IF(mode IN {"No bonuses","No bonuses or penalties"},[Cumulative Bonus Seconds],0)-IF(mode IN {"No penalties","No bonuses or penalties"},[Cumulative Penalty Seconds],0))
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: efb3f42b-64d7-45c3-9d2b-32d4caa189cc

	/// Scenario GC Rank
	measure 'Scenario GC Rank' = VAR t=[Scenario Seconds] VAR field=FILTER(ALL('Rider'),NOT ISBLANK(CALCULATE([Scenario Seconds]))) RETURN IF(NOT ISBLANK(t),RANKX(field,[Scenario Seconds],t,ASC,Skip))
		formatString: 0
		displayFolder: PDF analytics
		lineageTag: d3d79644-10a9-47e2-8a0e-466efda790f0

	/// Scenario Rank Change
	measure 'Scenario Rank Change' = IF(NOT ISBLANK([GC Rank]),[GC Rank]-[Scenario GC Rank])
		formatString: 0
		displayFolder: PDF analytics
		lineageTag: 05089664-69db-4aff-98e0-36c37d078458

	/// Top Ten Movement
	measure 'Top Ten Movement' = VAR a=[GC Rank] VAR b=[Scenario GC Rank] RETURN IF(NOT ISBLANK(a),SWITCH(TRUE(),a>10 && b<=10,"Entered top 10",a<=10 && b>10,"Left top 10",a<=10,"Stayed top 10","Outside top 10"))
		displayFolder: PDF analytics
		lineageTag: e450446d-70e8-4000-bf1a-f1264dfbf77a

	/// Country Wins
	measure 'Country Wins' = CALCULATE([Stage Wins],KEEPFILTERS(TREATAS(VALUES('Country'[Country]),'Rider'[Rider Country])))
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: bdc9bb4a-9f5c-4553-bb7e-9609e13e9ccf

	/// Country Podiums
	measure 'Country Podiums' = CALCULATE([Stage Podiums],KEEPFILTERS(TREATAS(VALUES('Country'[Country]),'Rider'[Rider Country])))
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: 426a9e98-f8e5-4639-ad40-a43c6b039a4b

	/// Country Best GC Rank
	measure 'Country Best GC Rank' = VAR s=[As of Stage Number] RETURN CALCULATE(MIN('Standing'[GC Rank]),REMOVEFILTERS('Stage'),'Standing'[Stage]=s,KEEPFILTERS(TREATAS(VALUES('Country'[Country]),'Rider'[Rider Country])))
		formatString: 0
		displayFolder: PDF analytics
		lineageTag: e551616e-7fe1-4d9f-ad4f-b8d18325f33d

	/// Country Result Count
	measure 'Country Result Count' = CALCULATE(COUNTROWS('Result'),KEEPFILTERS(TREATAS(VALUES('Country'[Country]),'Rider'[Rider Country])))
		formatString: #,0
		displayFolder: PDF analytics
		lineageTag: b2ddb0ad-76b7-4ee0-91c3-55eae8380caa

	column Label
		dataType: string
