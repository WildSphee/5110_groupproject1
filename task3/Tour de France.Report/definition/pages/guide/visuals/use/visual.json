                      "fontFamily": "Segoe UI",
                      "fontSize": "14pt",
                      "color": "#182B3A",
                      "fontWeight": "normal"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "For charts: select → enable ↓ → click a bar. Use ↑ to roll up. For matrices: expand + or use drill arrows. Select a row or mark to filter other visuals; click it again to clear. In Desktop, Ctrl+click is needed for action buttons only.",
